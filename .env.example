# local | staging | production
APP_ENV=local
HTTP_PORT=8080
POSTGRES_DB=nodovip
POSTGRES_USER=nodovip
POSTGRES_PASSWORD=cambia_esto
REDIS_PASSWORD=cambia_esto

# Firma de los tokens de sesión (PB-01). Obligatorio fuera de local/test, mínimo
# 32 caracteres. Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# En local puede quedar vacío (se usa un secreto de desarrollo).
JWT_SECRETO=

# Cookie de sesión solo por HTTPS. Vacío = automático (activa fuera de local/test).
# Poner false solo si la VM todavía no tiene HTTPS.
COOKIE_SEGURA=

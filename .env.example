# local | staging | production
APP_ENV=local
HTTP_PORT=8080
POSTGRES_DB=nodovip
POSTGRES_USER=nodovip
POSTGRES_PASSWORD=cambia_esto
REDIS_PASSWORD=cambia_esto

# Firma de los tokens de sesión (PB-01). Obligatorio fuera de local/test, mínimo
# 32 caracteres. Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# En local puede quedar vacío (se usa un secreto de desarrollo).
JWT_SECRETO=

# Cookie de sesión solo por HTTPS. Vacío = automático (activa fuera de local/test).
# Poner false solo si la VM todavía no tiene HTTPS.
COOKIE_SEGURA=

# Invitaciones por correo con Brevo (PB-06). Sin clave, los correos se escriben
# en el log del backend (docker compose logs -f backend).
# APP_URL: dirección pública del frontend, para el enlace del correo.
APP_URL=http://localhost:8080
BREVO_API_KEY=
# Remitente verificado en Brevo (Senders & IP).
CORREO_REMITENTE=
CORREO_REMITENTE_NOMBRE=NODOVIP Tabletop

# Contraseña de los usuarios ficticios de app.seed_usuarios_demo (solo local/staging).
DEMO_CONTRASENA=
